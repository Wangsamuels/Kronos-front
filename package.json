{
  "name": "kronos-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "api:gen": "openapi-typescript ${OPENAPI_SRC:-contracts/openapi.json} -o src/api/schema.d.ts",
    "api:gen:live": "openapi-typescript ${NEXT_PUBLIC_API_URL}/openapi.json -o src/api/schema.d.ts",
    "msw:init": "msw init public --save"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.11.0",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/analytics": "^2.0.1",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^14.11.1",
    "next": "^15.5.29",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "viem": "^2.57.17",
    "wagmi": "^3.7.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "msw": "^3.0.4",
    "openapi-msw": "^2.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
