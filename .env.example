# Empty = run entirely against MSW mocks (scripted analysis run, no backend needed).
# Set to /api to go live through the same-origin proxy (next.config.ts rewrites /api/* to the backend).
# next.config.ts already defaults to /api for `pnpm build`; build on mocks with `NEXT_PUBLIC_API_URL= pnpm build`.
NEXT_PUBLIC_API_URL=
# Where the live log (SSE) connects. Empty = same as NEXT_PUBLIC_API_URL. The backend must allow this origin in CORS_ORIGINS.
NEXT_PUBLIC_API_DIRECT_URL=
# Server-side only: where /api/* is proxied (defaults to the Heroku app).
KRONOS_API_ORIGIN=
# WalletConnect Cloud project id (optional; injected wallets work without it).
NEXT_PUBLIC_WALLETCONNECT_ID=
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_CHAINS=aurora-testnet,base-sepolia
# Optional. Leave empty locally; Sentry stays off.
NEXT_PUBLIC_SENTRY_DSN=
